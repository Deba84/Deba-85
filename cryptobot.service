[Unit]
Description=Crypto Liquidity Scanner Bot Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/path/to/your/app
ExecStart=/usr/bin/python3 cli.py --market crypto --interval 15 --telegram
Restart=always
RestartSec=10

# Set Telegram Environment Variables (or set them in system environment)
Environment=TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
Environment=TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"

[Install]
WantedBy=multi-user.target
